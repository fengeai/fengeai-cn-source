{
  "name": "content-assistant-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @content-assistant/web run dev",
    "dev:api": "npm --workspace @content-assistant/api run dev",
    "build:web": "npm --workspace @content-assistant/web run build",
    "build:api": "npm --workspace @content-assistant/api run build"
  }
}
